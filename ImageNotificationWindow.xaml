<Window x:Class="Qusasa.ImageNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource UiQusasaNotification}" Width="368" Height="146" WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" ShowActivated="False" Topmost="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
    <Border Style="{StaticResource PanelBorder}" Padding="13,8,13,12" FlowDirection="{DynamicResource UiDirection}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Image Source="{DynamicResource AppMarkImage}" Width="20" Height="20" Margin="0,0,7,0" />
                <TextBlock Text="{DynamicResource UiQusasa}" FontWeight="SemiBold" />
            </StackPanel>
            <Button Style="{StaticResource Quiet}" MinHeight="26" Width="29" Padding="0" HorizontalAlignment="Right"
                    AutomationProperties.Name="{DynamicResource UiDismissNotification}" Click="Dismiss">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" FontSize="11" />
            </Button>
            <Grid Grid.Row="1" Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border x:Name="ThumbnailFrame" Width="98" Background="{DynamicResource Input}" CornerRadius="7" BorderThickness="1"
                        BorderBrush="{DynamicResource QuietLine}" Padding="3" Margin="0,0,10,0">
                    <Image x:Name="Thumbnail" FlowDirection="LeftToRight" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="{DynamicResource UiCopiedImageThumbnail}" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="Message" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock x:Name="PreviewText" MaxHeight="39" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Secondary}" Margin="0,3,0,0" />
                    <Button x:Name="OpenClipButton" Style="{StaticResource Quiet}" Content="{DynamicResource UiOpenClip}" Foreground="{DynamicResource Accent}"
                            HorizontalAlignment="Left" Padding="0" MinHeight="30" Margin="0,3,0,0" Click="OpenClip" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
