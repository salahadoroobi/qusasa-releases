<Window x:Class="Qusasa.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize"
        Width="438" SizeToContent="Height" AllowsTransparency="True" ShowInTaskbar="False"
        Background="Transparent" FlowDirection="{DynamicResource UiDirection}" FontFamily="Segoe UI"
        FontSize="14" Foreground="{DynamicResource Text}" UseLayoutRounding="True">
    <Border Style="{StaticResource PanelBorder}" Padding="22">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource DangerTint}"
                        Margin="0,0,12,0" VerticalAlignment="Top">
                    <TextBlock x:Name="PromptIcon" Style="{StaticResource Glyph}" FontSize="20"
                               HorizontalAlignment="Center" Foreground="{DynamicResource Danger}" />
                </Border>
                <StackPanel Grid.Column="1" Margin="0,1,0,0">
                    <TextBlock x:Name="PromptTitle" FontSize="{DynamicResource Heading20}" FontFamily="{DynamicResource HeadingFont}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="PromptMessage" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,6,0,0" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0">
                <Button x:Name="CancelButton" MinWidth="84" Content="{DynamicResource UiCancel}" IsCancel="True" IsDefault="True" Margin="0,0,8,0" />
                <Button x:Name="AcceptButton" MinWidth="108" Click="AcceptClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
