<Window x:Class="Qusasa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="{DynamicResource UiQusasa}" Icon="{DynamicResource AppMarkImage}" Width="1090" Height="720" MinWidth="820" MinHeight="550"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        FontFamily="Segoe UI" FontSize="14" Background="{DynamicResource Frame}"
        Foreground="{DynamicResource Text}" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="WindowKeyDown" StateChanged="WindowStateChanged">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="14" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Grid Background="{DynamicResource Frame}">
        <Grid x:Name="Workspace" FlowDirection="{DynamicResource UiDirection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="56" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>
            <Border BorderBrush="{DynamicResource QuietLine}" BorderThickness="0,0,0,1">
                <Grid Margin="22,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <Image Source="{DynamicResource AppMarkImage}" Width="29" Height="29" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <TextBlock Text="{DynamicResource UiQusasa}" FontSize="{DynamicResource Heading17}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" Foreground="{DynamicResource Text}" Margin="0,0,9,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Chrome}" Click="MinimizeClick" ToolTip="{DynamicResource UiMinimize}" AutomationProperties.Name="{DynamicResource UiMinimize}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE921;" />
                        </Button>
                        <Button Style="{StaticResource Chrome}" Click="MaximizeClick" ToolTip="{DynamicResource UiMaximizeOrRestore}" AutomationProperties.Name="{DynamicResource UiMaximizeOrRestore}">
                            <TextBlock x:Name="MaximizeGlyph" Style="{StaticResource Glyph}" FontSize="10" Text="&#xE922;" />
                        </Button>
                        <Button Style="{StaticResource CloseChrome}" Click="CloseClick" ToolTip="{DynamicResource UiCloseWindow}" AutomationProperties.Name="{DynamicResource UiCloseWindow}">
                            <TextBlock Style="{StaticResource Glyph}" FontSize="10" Text="&#xE8BB;" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="27,24,27,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{DynamicResource UiClipboardHistory}" FontSize="{DynamicResource Heading32}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" />
                    <TextBlock Text="{DynamicResource UiSearchTheTextAndImagesYouCopied}" Foreground="{DynamicResource Secondary}" Margin="0,3,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CaptureButton" Click="ToggleCaptureClick" Margin="0,0,8,0" AutomationProperties.Name="{DynamicResource UiToggleClipboardMonitoring}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="CaptureDot" Width="7" Height="7" Fill="{DynamicResource Signal}" Margin="0,0,8,0" />
                            <TextBlock x:Name="CaptureLabel" Text="{DynamicResource UiMonitoringOn}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SettingsButton" Click="OpenSettings" Width="38" Padding="0" Margin="0,0,8,0"
                            AutomationProperties.Name="{DynamicResource UiSettings}" ToolTip="{DynamicResource UiSettings}">
                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" />
                    </Button>
                    <Button x:Name="NewButton" Style="{StaticResource Primary}" Click="NewClick" AutomationProperties.Name="{DynamicResource UiNewClip}" ToolTip="{DynamicResource UiNewClipCtrlN}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource UiNewClip}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="27,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.06*" />
                    <ColumnDefinition Width="15" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource PanelBorder}">
                    <Grid Margin="14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="38" />
                            <RowDefinition Height="45" />
                            <RowDefinition Height="38" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="37,0,10,0" MaxLength="256" TextChanged="SearchChanged"
                                     AutomationProperties.Name="{DynamicResource UiSearchClips}" VerticalContentAlignment="Center" />
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Left" Margin="12,0,0,0" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchHint" Text="{DynamicResource UiSearchClipsLabel}" Foreground="{DynamicResource Muted}"
                                       HorizontalAlignment="Left" Margin="37,0,0,0" IsHitTestVisible="False" />
                        </Grid>
                        <WrapPanel Grid.Row="1" x:Name="Filters" Orientation="Horizontal" VerticalAlignment="Center">
                                <RadioButton x:Name="AllFilter" GroupName="Filter" Content="{DynamicResource UiAll}" Style="{StaticResource Filter}" IsChecked="True" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                                <RadioButton x:Name="PinnedFilter" GroupName="Filter" Content="{DynamicResource UiPinned}" Style="{StaticResource Filter}" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                                <RadioButton x:Name="ImagesFilter" GroupName="Filter" Content="{DynamicResource UiImages}" Style="{StaticResource Filter}" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                                <RadioButton x:Name="TextFilter" GroupName="Filter" Content="{DynamicResource UiTextLabel}" Style="{StaticResource Filter}" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                                <RadioButton x:Name="LinksFilter" GroupName="Filter" Content="{DynamicResource UiLinks}" Style="{StaticResource Filter}" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                            <RadioButton x:Name="PathsFilter" GroupName="Filter" Content="{DynamicResource UiPaths}" Style="{StaticResource Filter}" Margin="0,0,4,3" Padding="8,6" Checked="FilterChanged" />
                        </WrapPanel>
                        <Grid Grid.Row="2" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="1" x:Name="CountLabel" HorizontalAlignment="Center" Margin="0,0,4,0" FontSize="12" Foreground="{DynamicResource Muted}" />
                            <ComboBox x:Name="HistoryDayMenu" MinWidth="132" HorizontalAlignment="Left" SelectionChanged="FilterChanged"
                                      AutomationProperties.Name="{DynamicResource UiHistoryDay}"/>
                            <Button x:Name="ExportDayButton" Grid.Column="2" Content="{DynamicResource UiExportDay}"
                                    MinHeight="30" Padding="10,0" Click="ExportDayClick" IsEnabled="False"/>
                        </Grid>
                        <ListBox x:Name="ClipList" Grid.Row="3" SelectionChanged="SelectionChanged" MouseDoubleClick="ListDoubleClick"
                                 AutomationProperties.Name="{DynamicResource UiClipList}" Style="{StaticResource ClipListSurface}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ItemContainerStyle="{StaticResource ClipRow}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="43">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="41" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource Elevated}" CornerRadius="7" Width="33" Height="33" HorizontalAlignment="Left">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock TextTrimming="CharacterEllipsis" FontWeight="SemiBold">
                                                <Run Text="{Binding Caption, Mode=OneWay}" FlowDirection="{Binding Direction}" />
                                            </TextBlock>
                                            <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <TextBlock Style="{StaticResource Glyph}" Text="{Binding PinGlyph}" FontSize="11" Foreground="{DynamicResource Accent}"
                                                       HorizontalAlignment="Right" AutomationProperties.Name="{DynamicResource UiPinnedLabel}" />
                                            <TextBlock Text="{Binding TimeLabel}" FlowDirection="LeftToRight" Foreground="{DynamicResource Muted}"
                                                       FontSize="11" HorizontalAlignment="Right" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel x:Name="ListEmpty" Grid.Row="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" IsHitTestVisible="False">
                            <Border Width="51" Height="51" CornerRadius="11" Background="{DynamicResource Tint}" HorizontalAlignment="Center">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE77F;" FontSize="23" Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                            </Border>
                            <TextBlock x:Name="EmptyTitle" Text="{DynamicResource UiYourHistoryIsEmpty}" HorizontalAlignment="Center" FontWeight="SemiBold" FontSize="17" Margin="0,15,0,4" />
                            <TextBlock x:Name="EmptyDetail" Text="{DynamicResource UiCopyTextFromAnyAppToSee}" TextAlignment="Center"
                                       TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource PanelBorder}">
                    <Grid Margin="16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,1,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="PreviewTitle" Text="{DynamicResource UiClipPreview}" FontSize="{DynamicResource Heading19}" FontFamily="{DynamicResource HeadingFont}" FontWeight="SemiBold" />
                                <TextBlock x:Name="PreviewMeta" Text="{DynamicResource UiFullText}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel x:Name="ClipActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
                                <Button x:Name="ScanButton" Style="{StaticResource Quiet}" Width="34" Padding="0" Click="ScanImage"
                                        Visibility="Collapsed" AutomationProperties.Name="{DynamicResource UiScanImage}" ToolTip="{DynamicResource UiScanImage}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;"/>
                                </Button>
                                <Button x:Name="PinButton" Style="{StaticResource Quiet}" Width="34" Padding="0" Click="PinClick"
                                        AutomationProperties.Name="{DynamicResource UiPinClip}" ToolTip="{DynamicResource UiPinClip}">
                                    <TextBlock x:Name="PinIcon" Style="{StaticResource Glyph}" Text="&#xE718;" />
                                </Button>
                                <Button x:Name="EditButton" Style="{StaticResource Quiet}" Width="34" Padding="0" Click="EditClick" ToolTip="{DynamicResource UiEdit}" AutomationProperties.Name="{DynamicResource UiEdit}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE70F;" />
                                </Button>
                                <Button x:Name="DeleteButton" Style="{StaticResource Quiet}" Width="34" Padding="0" Click="DeleteClick" ToolTip="{DynamicResource UiDelete}" AutomationProperties.Name="{DynamicResource UiDelete}">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74D;" Foreground="{DynamicResource Danger}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                        <TextBox x:Name="Editor" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" IsReadOnly="True"
                                 Padding="13,10" FontSize="15" VerticalScrollBarVisibility="Auto" MaxLength="500000"
                                 TextChanged="EditorChanged" AutomationProperties.Name="{DynamicResource UiClipContent}" Visibility="Collapsed" />
                        <Border x:Name="PictureFrame" Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                Background="{DynamicResource Input}" CornerRadius="8" Padding="12" Visibility="Collapsed">
                            <Grid>
                                <Image x:Name="Picture" Stretch="Uniform" StretchDirection="DownOnly"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"
                                       AutomationProperties.Name="{DynamicResource UiImagePreview}" RenderOptions.BitmapScalingMode="HighQuality" />
                                <TextBlock x:Name="PictureError" Text="{DynamicResource UiUnableToDisplayImage}" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Danger}" Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Border x:Name="PreviewEmpty" Grid.Row="1" BorderBrush="{DynamicResource QuietLine}" BorderThickness="1"
                                Background="{DynamicResource Input}" CornerRadius="10">
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14">
                                <TextBlock Style="{StaticResource Glyph}" Text="&#xE8A5;" FontSize="28" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" />
                                <TextBlock Text="{DynamicResource UiSelectAClipToPreview}" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                        <Grid Grid.Row="2" Margin="0,13,0,0">
                            <TextBlock x:Name="CharacterCount" FontSize="12" Foreground="{DynamicResource Muted}" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CancelEditButton" Style="{StaticResource Quiet}" Content="{DynamicResource UiCancel}" Click="CancelEditClick" Visibility="Collapsed" Margin="0,0,6,0" />
                                <Button x:Name="SaveButton" Style="{StaticResource Primary}" Content="{DynamicResource UiSaveClip}" Click="SaveClick" Visibility="Collapsed" />
                                <Button x:Name="CopyButton" Style="{StaticResource Primary}" Click="CopyClick" IsEnabled="False" ToolTip="{DynamicResource UiCopyToClipboardCtrlEnter}"
                                        AutomationProperties.Name="{DynamicResource UiCopyToClipboard}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE8C8;" Margin="0,0,7,0" />
                                        <TextBlock Text="{DynamicResource UiCopyToClipboard}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="27,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Path Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource Accent}" StrokeThickness="1.4"
                          Data="M2,4 C2,0 14,0 14,4 L14,12 C14,16 2,16 2,12 Z M2,4 C2,8 14,8 14,4 M2,8 C2,12 14,12 14,8"
                          VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="StatusHistorySize" Margin="0,0,12,0" FontSize="12" Foreground="{DynamicResource Accent}"/>
                    <TextBlock x:Name="StatusGlyph" Style="{StaticResource Glyph}" Text="&#xE72E;" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock x:Name="StatusLabel" Text="{DynamicResource UiHistoryIsEncryptedAndStoredLocally}" FontSize="12" Foreground="{DynamicResource Secondary}"
                               TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="HotkeyLabel" Text="{DynamicResource UiOpenQusasa}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,0,8,0" />
                    <Border x:Name="HotkeyHint" Style="{StaticResource KeyHint}">
                        <TextBlock Text="Ctrl + Shift + Space" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Secondary}" />
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid x:Name="SettingsOverlay" FlowDirection="{DynamicResource UiDirection}" Visibility="Collapsed" Background="{DynamicResource Scrim}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="576" MaxHeight="644" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource PanelBorder}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,16">
                        <TextBlock Text="{DynamicResource UiSettings}" FontSize="{DynamicResource Heading25}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" />
                        <Button x:Name="CloseSettingsButton" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Width="34" Padding="0"
                                Click="CloseSettings" ToolTip="{DynamicResource UiCloseSettings}" AutomationProperties.Name="{DynamicResource UiCloseSettings}">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel>
                            <Expander x:Name="AppearanceSection" Header="{DynamicResource UiAppearance}" Style="{StaticResource SettingsSection}" IsExpanded="True">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiTheme}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{DynamicResource UiGlass}" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                            <CheckBox x:Name="GlassSetting" Style="{StaticResource SettingSwitch}" Margin="0,0,7,0"
                                                      AutomationProperties.Name="{DynamicResource UiGlass}" ToolTip="{DynamicResource UiGlassHelp}"
                                                      Checked="GlassChanged" Unchecked="GlassChanged"/>
                                        <ComboBox x:Name="ThemeMenu" Width="132" HorizontalAlignment="Right" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiTheme}" SelectionChanged="AppearanceChanged">
                                            <ComboBoxItem Tag="Auto" Content="{DynamicResource UiAutomatic}"/>
                                            <ComboBoxItem Tag="Dark" Content="{DynamicResource UiDark}"/>
                                            <ComboBoxItem Tag="Light" Content="{DynamicResource UiLight}"/>
                                            <ComboBoxItem Tag="Midnight" Content="{DynamicResource UiMidnight}"/>
                                            <ComboBoxItem Tag="Mint" Content="{DynamicResource UiMint}"/>
                                            <ComboBoxItem Tag="Iris" Content="{DynamicResource UiIris}"/>
                                            <ComboBoxItem Tag="Sand" Content="{DynamicResource UiSand}"/>
                                            <ComboBoxItem Tag="Ocean" Content="{DynamicResource UiOcean}"/>
                                            <ComboBoxItem Tag="Rose" Content="{DynamicResource UiRose}"/>
                                            <ComboBoxItem Tag="Forest" Content="{DynamicResource UiForest}"/>
                                        </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiHeadingFont}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ComboBox x:Name="TitleMenu" Width="42" Margin="0,0,6,0" Tag="FontSize" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiHeadingSize}" ToolTip="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" SelectionChanged="AppearanceChanged">
                                                <ComboBoxItem Tag="-2" Content="{DynamicResource UiSmall}"/>
                                                <ComboBoxItem Tag="0" Content="{DynamicResource UiMedium}"/>
                                                <ComboBoxItem Tag="4" Content="{DynamicResource UiLarge}"/>
                                            </ComboBox>
                                            <ComboBox x:Name="TitleFontMenu" Width="132"  SelectedValuePath="Tag"
                                                AutomationProperties.Name="{DynamicResource UiHeadingFont}" SelectionChanged="AppearanceChanged">
                                                <ComboBoxItem Tag="Segoe UI" Content="Segoe UI"/>
                                                <ComboBoxItem Tag="Tahoma" Content="Tahoma"/>
                                                <ComboBoxItem Tag="Arial" Content="Arial"/>
                                                <ComboBoxItem x:Name="ImportedTitleChoice" Tag="Custom" Visibility="Collapsed" />
                                                <ComboBoxItem Tag="Import" Content="{DynamicResource UiImportFont}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiClipFont}"/>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <ComboBox x:Name="SizeMenu" Width="42" Margin="0,0,6,0" Tag="FontSize" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiClipTextSize}" ToolTip="{Binding Path=(AutomationProperties.Name), RelativeSource={RelativeSource Self}}" SelectionChanged="AppearanceChanged">
                                                <ComboBoxItem Tag="13" Content="{DynamicResource UiSmall}"/>
                                                <ComboBoxItem Tag="15" Content="{DynamicResource UiMedium}"/>
                                                <ComboBoxItem Tag="18" Content="{DynamicResource UiLarge}"/>
                                            </ComboBox>
                                            <ComboBox x:Name="FontMenu" Width="132"  SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiClipFont}" SelectionChanged="AppearanceChanged">
                                                <ComboBoxItem Tag="Segoe UI" Content="Segoe UI"/>
                                                <ComboBoxItem Tag="Tahoma" Content="Tahoma"/>
                                                <ComboBoxItem Tag="Arial" Content="Arial"/>
                                                <ComboBoxItem Tag="Import" Content="{DynamicResource UiImportFont}"/>
                                            </ComboBox>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiLanguage}"/>
                                        <ComboBox x:Name="LanguageMenu" Width="132" HorizontalAlignment="Right" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiLanguage}" SelectionChanged="AppearanceChanged">
                                            <ComboBoxItem Tag="Auto" Content="{DynamicResource UiAutomatic}"/>
                                            <ComboBoxItem Tag="ar" Content="{DynamicResource UiArabicLanguage}"/>
                                            <ComboBoxItem Tag="en" Content="{DynamicResource UiEnglishLanguage}"/>
                                            <ComboBoxItem Tag="ja" Content="{DynamicResource UiJapaneseLanguage}"/>
                                            <ComboBoxItem Tag="zh" Content="{DynamicResource UiChineseLanguage}"/>
                                            <ComboBoxItem Tag="fr" Content="{DynamicResource UiFrenchLanguage}"/>
                                            <ComboBoxItem Tag="es" Content="{DynamicResource UiSpanishLanguage}"/>
                                        </ComboBox>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="NotificationsSection" Header="{DynamicResource UiNotifications}" Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiDesktopNotifications}" />
                                        <CheckBox x:Name="DesktopSetting" AutomationProperties.Name="{DynamicResource UiDesktopNotifications}"
                                                  Style="{StaticResource SettingSwitch}" Checked="NotificationChanged" Unchecked="NotificationChanged" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiShowClipContentInNotifications}" />
                                        <CheckBox x:Name="ContentSetting" AutomationProperties.Name="{DynamicResource UiShowClipContentInNotifications}"
                                                  Style="{StaticResource SettingSwitch}" Checked="NotificationChanged" Unchecked="NotificationChanged" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiPlayASoundWhenCopying}" />
                                        <CheckBox x:Name="SoundSetting" AutomationProperties.Name="{DynamicResource UiPlayASoundWhenCopying}"
                                                  Style="{StaticResource SettingSwitch}" Checked="NotificationChanged" Unchecked="NotificationChanged" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander x:Name="SystemSection" Header="{DynamicResource UiSystem}" Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiQusasaUpdates}"/>
                                        <ComboBox x:Name="UpdateModeMenu" Width="132" HorizontalAlignment="Right" SelectedValuePath="Tag"
                                                  AutomationProperties.Name="{DynamicResource UiQusasaUpdates}" SelectionChanged="UpdateModeChanged">
                                            <ComboBoxItem Tag="Auto" Content="{DynamicResource UiAutomatic}"/>
                                            <ComboBoxItem Tag="Manual" Content="{DynamicResource UiManualUpdates}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiHistoryUnitStyle}"/>
                                        <ComboBox x:Name="HistoryUnitsMenu" Width="132" HorizontalAlignment="Right"
                                                  SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource UiHistoryUnitStyle}"
                                                  SelectionChanged="HistoryUnitsChanged">
                                            <ComboBoxItem Tag="Full" Content="{DynamicResource UiFullUnits}"/>
                                            <ComboBoxItem Tag="Short" Content="{DynamicResource UiShortUnits}"/>
                                        </ComboBox>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiKeepRecordingWhenTheWindowCloses}" />
                                        <CheckBox x:Name="TraySetting" AutomationProperties.Name="{DynamicResource UiKeepRecordingWhenTheWindowCloses}"
                                                  Style="{StaticResource SettingSwitch}" Checked="TraySettingChanged" Unchecked="TraySettingChanged" />
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <TextBlock Text="{DynamicResource UiStartWithWindows}" />
                                        <CheckBox x:Name="StartupSetting" AutomationProperties.Name="{DynamicResource UiStartWithWindows}"
                                                  Style="{StaticResource SettingSwitch}" Checked="StartupChanged" Unchecked="StartupChanged" />
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{DynamicResource UiExperimentalFeatures}" Style="{StaticResource SettingsSection}">
                                <StackPanel>
                                <Grid Style="{StaticResource SettingRow}">
                                    <StackPanel ToolTip="{DynamicResource UiCaptureHelp}">
                                        <TextBlock Text="{DynamicResource UiScreenCapture}"/>
                                        <TextBlock Text="Ctrl + Alt + Q" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                   Foreground="{DynamicResource Secondary}" FontSize="12"/>
                                    </StackPanel>
                                    <CheckBox x:Name="CircleSetting" Style="{StaticResource SettingSwitch}" Checked="CircleChanged" Unchecked="CircleChanged" AutomationProperties.Name="{DynamicResource UiScreenCapture}" ToolTip="{DynamicResource UiCaptureHelp}"/>
                                </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <StackPanel ToolTip="{DynamicResource UiScannerHelp}">
                                            <TextBlock Text="{DynamicResource UiScanner}" />
                                            <TextBlock Text="Ctrl + Alt + O" FlowDirection="LeftToRight" HorizontalAlignment="Left"
                                                       Foreground="{DynamicResource Secondary}" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <ComboBox x:Name="ScannerModeMenu" Tag="ScanMode" SelectedValuePath="Tag" Width="42"
                                                  Margin="0,0,6,0" ToolTip="{DynamicResource UiAdvanced}"
                                                  AutomationProperties.Name="{DynamicResource UiAdvanced}" SelectionChanged="ScannerModeChanged">
                                            <ComboBoxItem Tag="Auto" Content="{DynamicResource UiAutomatic}"/>
                                            <ComboBoxItem Tag="Local" Content="{DynamicResource UiLocalScan}"/>
                                            <ComboBoxItem Tag="Cloud" Content="{DynamicResource UiCloudScan}"/>
                                        </ComboBox>
                                        <CheckBox x:Name="ScannerSetting" Style="{StaticResource SettingSwitch}" Checked="ScannerChanged"
                                                  Unchecked="ScannerChanged" AutomationProperties.Name="{DynamicResource UiScanner}" ToolTip="{DynamicResource UiScannerHelp}"/>
                                        </StackPanel>
                                    </Grid>
                                    <Grid Style="{StaticResource SettingRow}">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource UiInstantTranslation}"/>
                                            <TextBlock x:Name="TranslationShortcut" Text="Ctrl + Alt + T" FlowDirection="LeftToRight"
                                                       HorizontalAlignment="Left" Foreground="{DynamicResource Secondary}" FontSize="12"/>
                                        </StackPanel>
                                        <TextBlock Text="{DynamicResource UiComingSoon}" HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" TextAlignment="Center" MinWidth="50"
                                                   Foreground="{DynamicResource Muted}"/>
                                    </Grid>
                                </StackPanel>
                            </Expander>
                            <Expander Header="{DynamicResource UiHistoryAndBackups}" Style="{StaticResource SettingsSection}">
                                <StackPanel Margin="0,4,0,4">
                                    <TextBlock Text="{DynamicResource UiImportAJsonArchiveOrATxt}"
                                               FontSize="12" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="SettingsHistorySize" Foreground="{DynamicResource Accent}" Margin="0,7,0,0"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,11,0,0">
                                        <Button x:Name="ImportButton" Content="{DynamicResource UiImport}" Click="ImportClick" Margin="0,0,8,0" />
                                        <Button x:Name="ExportButton" Content="{DynamicResource UiExport}" Click="ExportClick" Margin="0,0,8,0" />
                                        <Button x:Name="ClearButton" Content="{DynamicResource UiClearUnpinned}" Foreground="{DynamicResource Danger}" Click="ClearClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                    <Button x:Name="AboutButton" Grid.Row="2" Click="OpenAbout" Margin="0,8,0,0" HorizontalAlignment="Center"
                            AutomationProperties.Name="{DynamicResource UiAboutQusasa}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE946;" Margin="0,0,8,0" />
                            <TextBlock Text="{DynamicResource UiAboutQusasa}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>

        <Grid x:Name="AboutOverlay" FlowDirection="{DynamicResource UiDirection}" Visibility="Collapsed" Background="{DynamicResource Scrim}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PanelBorder}" Padding="24">
                <StackPanel>
                    <Grid>
                        <StackPanel HorizontalAlignment="Center">
                            <Image Source="{DynamicResource AppMarkImage}" Width="42" Height="42" />
                            <TextBlock Text="{DynamicResource UiAboutQusasa}" FontSize="{DynamicResource Heading24}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                            <Button x:Name="CheckUpdateButton" Click="CheckUpdateClick" Content="{DynamicResource UiCheckUpdates}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button x:Name="AboutBackButton" Click="CloseAbout" Content="{DynamicResource UiBack}"
                                Style="{StaticResource Quiet}" VerticalAlignment="Top" HorizontalAlignment="Right"/>
                        <Button x:Name="AboutVersionButton" Style="{StaticResource Quiet}" Click="OpenWhatsNew" Foreground="{DynamicResource Accent}"
                                VerticalAlignment="Top" HorizontalAlignment="Left" ToolTip="{DynamicResource UiSeeWhatSNewInThisRelease}"/>
                    </Grid>
                    <Border Background="{DynamicResource Input}" CornerRadius="8" Padding="12" Margin="0,12">
                        <StackPanel><TextBlock Text="{DynamicResource UiDeveloper}" HorizontalAlignment="Center" Foreground="{DynamicResource Muted}"/>
                        <TextBlock Text="{DynamicResource UiDeveloperName}" HorizontalAlignment="Center" FontWeight="SemiBold"/></StackPanel>
                    </Border>
                    <TextBlock Text="{DynamicResource UiContact}" HorizontalAlignment="Center" FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,14">
                        <Button x:Name="WhatsAppButton" Tag="https://wa.me/967772934757" ToolTip="{DynamicResource UiWhatsapp}" AutomationProperties.Name="{DynamicResource UiWhatsapp}" Click="ContactClick" Width="44" Height="40" Padding="0" Margin="3,0"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource WhatsAppMark}" /></Button>
                        <Button x:Name="TelegramButton" Tag="https://t.me/Salahadoroobi" ToolTip="{DynamicResource UiTelegram}" AutomationProperties.Name="{DynamicResource UiTelegram}" Click="ContactClick" Width="44" Height="40" Padding="0" Margin="3,0"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource TelegramMark}" /></Button>
                        <Button x:Name="GitHubButton" Tag="https://github.com/salahadoroobi" ToolTip="GitHub" AutomationProperties.Name="GitHub" Click="ContactClick" Width="44" Height="40" Padding="0" Margin="3,0"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource GitHubMark}" /></Button>
                        <Button x:Name="EmailButton" Tag="mailto:salahadoroobi@gmail.com" ToolTip="{DynamicResource UiEmail}" AutomationProperties.Name="{DynamicResource UiEmail}" Click="ContactClick" Width="44" Height="40" Padding="0" Margin="3,0"><Path Margin="0" Style="{StaticResource ContactIcon}" Width="18" Height="18"
                                      Data="F0 M2,4 H22 V20 H2 Z M4,7 V18 H20 V7 L12,13 Z M6,6 L12,10.5 18,6 Z" /></Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button x:Name="FeedbackButton" Click="OpenFeedback" Content="{DynamicResource UiSendASuggestion}" Margin="4,0"/>

                    </StackPanel>
                    <TextBlock Text="{DynamicResource Ui2026AllRightsReserved}" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,12,0,0"/>
                </StackPanel>
            </Border>
        </Grid>
        <Grid x:Name="WhatsNewOverlay" FlowDirection="{DynamicResource UiDirection}" Visibility="Collapsed" Background="{DynamicResource Scrim}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="560" Margin="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource PanelBorder}" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,19">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="{DynamicResource AppMarkImage}" Width="46" Height="46" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="HighQuality" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource UiWhatSNew}" FontSize="{DynamicResource Heading26}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" />
                                <TextBlock x:Name="ReleaseVersion" FontSize="12" Foreground="{DynamicResource Accent}" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="WhatsNewBackButton" Style="{StaticResource Quiet}" Content="{DynamicResource UiBack}"
                                HorizontalAlignment="Right" Click="CloseWhatsNew"
                                AutomationProperties.Name="{DynamicResource UiBackToAboutQusasa}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl x:Name="ReleaseChanges">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource Input}" BorderBrush="{DynamicResource QuietLine}" BorderThickness="1"
                                            CornerRadius="8" Margin="0,0,0,7" Padding="12,9">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="16" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="6" Height="6" VerticalAlignment="Top" HorizontalAlignment="Left"
                                                     Fill="{DynamicResource Accent}" Margin="0,8,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource Text}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"
                                                           Margin="0,4,0,0" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
        <Grid x:Name="FeedbackOverlay" FlowDirection="{DynamicResource UiDirection}" Visibility="Collapsed" Background="{DynamicResource Scrim}"
              KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="560" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Style="{StaticResource PanelBorder}" Padding="24">
                <ScrollViewer MaxHeight="420" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="FeedbackTitle" Text="{DynamicResource UiShareYourIdea}" FontSize="{DynamicResource Heading24}" FontFamily="{DynamicResource HeadingFont}" FontWeight="Bold" />
                        <Button x:Name="FeedbackBackButton" Style="{StaticResource Quiet}" Content="{DynamicResource UiBack}"
                                HorizontalAlignment="Right" Click="CloseFeedback"
                                AutomationProperties.Name="{DynamicResource UiBackToAboutQusasa}" />
                    </Grid>
                    <WrapPanel x:Name="FeedbackCategories" Margin="0,0,0,14">
                        <RadioButton x:Name="SuggestionChoice" GroupName="FeedbackCategory" Content="{DynamicResource UiSuggestion}"
                                     IsChecked="True" Style="{StaticResource Filter}" />
                        <RadioButton x:Name="FeatureChoice" GroupName="FeedbackCategory" Content="{DynamicResource UiRequestAFeature}"
                                     Margin="6,0" Style="{StaticResource Filter}" />
                        <RadioButton x:Name="ImprovementChoice" GroupName="FeedbackCategory" Content="{DynamicResource UiImproveAFeature}"
                                     Style="{StaticResource Filter}" />
                    </WrapPanel>
                    <TextBlock x:Name="FeedbackPrompt" TextWrapping="Wrap" Text="{DynamicResource UiWhatWouldYouLikeToAddOr}" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBox x:Name="FeedbackText" Height="112" TextWrapping="Wrap" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto" MaxLength="260" TextChanged="FeedbackChanged"
                             AutomationProperties.Name="{DynamicResource UiSuggestionDetails}" />
                    <CheckBox x:Name="IncludeDiagnostics" Visibility="Collapsed" Margin="0,9,0,5"
                              Content="{DynamicResource UiIncludeDiagnostics}"/>
                    <Expander x:Name="DiagnosticsPreview" Visibility="Collapsed" Header="{DynamicResource UiReviewDiagnostics}" Margin="0,0,0,5">
                        <TextBox x:Name="DiagnosticText" IsReadOnly="True" Height="83" VerticalScrollBarVisibility="Auto"
                                 TextWrapping="Wrap" FlowDirection="LeftToRight"/>
                    </Expander>
                    <TextBlock x:Name="FeedbackCount" FontSize="12" Foreground="{DynamicResource Secondary}"
                               FlowDirection="LeftToRight" Margin="0,6,0,4"/>
                    <WrapPanel x:Name="FeedbackChannels" HorizontalAlignment="Center">
                        <Button Tag="whatsapp" ToolTip="{DynamicResource UiWhatsapp}" AutomationProperties.Name="{DynamicResource UiWhatsapp}" Click="OpenFeedbackDraft" Width="44" Height="40" Padding="0" Margin="0,0,5,4"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource WhatsAppMark}"/></Button>
                        <Button Tag="telegram" ToolTip="{DynamicResource UiTelegram}" AutomationProperties.Name="{DynamicResource UiTelegram}" Click="OpenFeedbackDraft" Width="44" Height="40" Padding="0" Margin="0,0,5,4"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource TelegramMark}"/></Button>
                        <Button Tag="github" ToolTip="GitHub" AutomationProperties.Name="GitHub" Click="OpenFeedbackDraft" Width="44" Height="40" Padding="0" Margin="0,0,5,4"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="{StaticResource GitHubMark}"/></Button>
                        <Button Tag="email" ToolTip="{DynamicResource UiEmail}" AutomationProperties.Name="{DynamicResource UiEmail}" Click="OpenFeedbackDraft" Width="44" Height="40" Padding="0" Margin="0,0,5,4"><Path Margin="0" Style="{StaticResource ContactIcon}" Data="F0 M2,4 H22 V20 H2 Z M4,7 V18 H20 V7 L12,13 Z M6,6 L12,10.5 18,6 Z"/></Button>
                    </WrapPanel>
                    <TextBlock x:Name="FeedbackDeliveryHint" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" />
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid x:Name="UpdateOverlay" FlowDirection="{DynamicResource UiDirection}" Visibility="Collapsed"
              Background="{DynamicResource Scrim}" KeyboardNavigation.TabNavigation="Cycle">
            <Border Width="548" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource PanelBorder}" Padding="23">
                <StackPanel>
                    <TextBlock Text="{DynamicResource UiQusasaUpdates}" FontSize="{DynamicResource Heading24}" FontWeight="Bold" TextAlignment="Center"/>
                    <TextBlock x:Name="UpdateStatus" Foreground="{DynamicResource Accent}" Margin="0,8,0,10" TextWrapping="Wrap"
                               TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/>
                    <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="UpdateHighlights" TextWrapping="Wrap" />
                    </ScrollViewer>
                    <ProgressBar x:Name="UpdateProgress" Visibility="Collapsed" Height="5" Margin="0,14,0,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,17,0,0">
                        <Button x:Name="UpdateAction" Visibility="Collapsed" Click="UpdateActionClick" Style="{StaticResource Primary}" Margin="0,0,8,0"/>
                        <Button x:Name="UpdateLater" Click="UpdateLaterClick" Content="{DynamicResource UiBack}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <Border x:Name="UpdateDownloadNotice" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                Style="{StaticResource PanelBorder}" Padding="9" Margin="12,0,12,43">
            <Button x:Name="UpdateNoticeButton" Click="UpdateNoticeClick" Style="{StaticResource Quiet}" Foreground="{DynamicResource Accent}"/>
        </Border>
        <Border x:Name="PromptScrim" Visibility="Collapsed" Background="{DynamicResource Scrim}" />
    </Grid>
</Window>
