<Window x:Class="Qusasa.SetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen"
 Background="{DynamicResource Frame}" Foreground="{DynamicResource Text}" FontFamily="Segoe UI" FontSize="14"
 Title="{DynamicResource UiQusasa}" Icon="{DynamicResource AppMarkImage}" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="PlatformGlyph" TargetType="Path">
   <Setter Property="Width" Value="16"/>
   <Setter Property="Height" Value="16"/>
   <Setter Property="Stretch" Value="Uniform"/>
   <Setter Property="Fill" Value="{DynamicResource Secondary}"/>
   <Setter Property="FlowDirection" Value="LeftToRight"/>
   <Setter Property="HorizontalAlignment" Value="Center"/>
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="14" /></shell:WindowChrome.WindowChrome>
 <Border Width="790" Height="540" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="14" FlowDirection="{DynamicResource UiDirection}">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="53"/><RowDefinition/><RowDefinition Height="73"/></Grid.RowDefinitions>
   <Border BorderBrush="{DynamicResource QuietLine}" BorderThickness="0,0,0,1">
    <DockPanel Margin="22,0">
     <Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Width="35" Padding="0" VerticalAlignment="Center"
       ToolTip="{DynamicResource UiClose}" AutomationProperties.Name="{DynamicResource UiClose}" shell:WindowChrome.IsHitTestVisibleInChrome="True" Click="CancelClick">
      <TextBlock Style="{StaticResource Glyph}" Text="&#xE8BB;"/>
     </Button>
     <StackPanel Orientation="Horizontal">
      <Image Source="{DynamicResource AppMarkImage}" Width="26" Height="26" Margin="0,0,9,0"/>
      <TextBlock Text="{DynamicResource UiQusasa}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     </StackPanel>
    </DockPanel>
   </Border>
   <Grid Grid.Row="1" Margin="25,23">
    <Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Style="{StaticResource PanelBorder}" Padding="15" Background="{DynamicResource Panel}">
     <DockPanel>
      <StackPanel DockPanel.Dock="Bottom" x:Name="Platform" Margin="0,8,0,0">
       <Border Height="1" Background="{DynamicResource QuietLine}" Margin="0,0,0,7"/>
       <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
        <Path Style="{StaticResource PlatformGlyph}" Fill="{DynamicResource Accent}" Width="14" Height="14"
              AutomationProperties.Name="Windows" ToolTip="Windows"
              Data="M1,1 H9 V9 H1 Z M11,1 H19 V9 H11 Z M1,11 H9 V19 H1 Z M11,11 H19 V19 H11 Z"/>
        <TextBlock Text="{DynamicResource UiMultiPlatform}" Foreground="{DynamicResource Accent}"
                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/>
       </StackPanel>
       <UniformGrid Columns="4" Width="140" Height="20" HorizontalAlignment="Center">
        <Path Style="{StaticResource PlatformGlyph}" AutomationProperties.Name="macOS" ToolTip="macOS"
              Data="F0 M4,1 H20 Q21,1 21,2 V15 H3 V2 Q3,1 4,1 Z M5,3 V13 H19 V3 Z M1,17 H23 L21,20 H3 Z"/>
        <Path Style="{StaticResource PlatformGlyph}" AutomationProperties.Name="Linux" ToolTip="Linux"
              Data="F0 M12,1 C16,1 17,4 17,8 C17,11 21,14 21,18 L23,21 Q22,23 17,22 L14,21 H10 L7,22 Q2,23 1,21 L3,18 C3,14 7,11 7,8 C7,4 8,1 12,1 Z M9,6 A1,1 0 1 0 11,6 A1,1 0 1 0 9,6 Z M13,6 A1,1 0 1 0 15,6 A1,1 0 1 0 13,6 Z M9,9 L12,11 L15,9 L12,8 Z M12,12 C8,12 7,16 8,19 Q12,21 16,19 C17,16 16,12 12,12 Z"/>
        <Path Style="{StaticResource PlatformGlyph}" AutomationProperties.Name="Android" ToolTip="Android"
              Data="F0 M1,19 C1,14 3,10 7,8 L4,3 L5,2 L9,7 Q12,6 15,7 L19,2 L20,3 L17,8 C21,10 23,14 23,19 Z M6,13 A1.5,1.5 0 1 0 9,13 A1.5,1.5 0 1 0 6,13 Z M15,13 A1.5,1.5 0 1 0 18,13 A1.5,1.5 0 1 0 15,13 Z"/>
        <Path Style="{StaticResource PlatformGlyph}" AutomationProperties.Name="iPhone" ToolTip="iPhone"
              Data="F0 M7,1 H17 Q19,1 19,3 V21 Q19,23 17,23 H7 Q5,23 5,21 V3 Q5,1 7,1 Z M7,3 V21 H17 V3 H15 L14,5 H10 L9,3 Z M10,18 H14 V19 H10 Z"/>
       </UniformGrid>
       <TextBlock Text="{DynamicResource UiComingSoon}" HorizontalAlignment="Center" FontSize="11"
                  Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/>
      </StackPanel>
      <StackPanel>
       <StackPanel Orientation="Horizontal" Margin="7,3,0,17">
        <Image Source="{DynamicResource AppMarkImage}" Width="48" Height="48"/>
        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
         <TextBlock x:Name="VersionLabel" Foreground="{DynamicResource Muted}" FontSize="12"/>
         <TextBlock x:Name="PageVersion" Foreground="{DynamicResource Accent}" FontSize="16" FontWeight="SemiBold"/>
        </StackPanel>
       </StackPanel>
       <Border x:Name="IntroStep" CornerRadius="8" Padding="8,9"><TextBlock x:Name="IntroLabel"/></Border>
       <Border x:Name="OptionsStep" CornerRadius="8" Padding="8,9"><TextBlock x:Name="OptionsLabel"/></Border>
       <Border x:Name="ReviewStep" CornerRadius="8" Padding="8,9"><TextBlock x:Name="ReviewLabel"/></Border>
       <Border x:Name="InstallStep" CornerRadius="8" Padding="8,9"><TextBlock x:Name="InstallLabel"/></Border>
       <Border x:Name="DoneStep" CornerRadius="8" Padding="8,9"><TextBlock x:Name="DoneLabel"/></Border>
      </StackPanel>
     </DockPanel>
    </Border>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock x:Name="PageTitle" FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,4"/>
     </StackPanel>
     <TextBlock Grid.Row="1" x:Name="PageDescription" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,0,0,16"/>
     <Grid Grid.Row="2">
      <StackPanel x:Name="IntroPage">
       <ComboBox x:Name="SetupLanguage" Width="168" HorizontalAlignment="Left" SelectionChanged="LanguageChanged" AutomationProperties.Name="{DynamicResource UiLanguage}">
        <ComboBoxItem Tag="ar" Content="{DynamicResource UiArabicLanguage}"/><ComboBoxItem Tag="en" Content="{DynamicResource UiEnglishLanguage}"/>
        <ComboBoxItem Tag="ja" Content="{DynamicResource UiJapaneseLanguage}"/><ComboBoxItem Tag="zh" Content="{DynamicResource UiChineseLanguage}"/><ComboBoxItem Tag="fr" Content="{DynamicResource UiFrenchLanguage}"/><ComboBoxItem Tag="es" Content="{DynamicResource UiSpanishLanguage}"/>
       </ComboBox>
       <Border Style="{StaticResource PanelBorder}" Padding="12" Margin="0,12,0,0">
        <StackPanel>
         <Image Source="SetupFeature.bmp" Height="118" Stretch="Uniform" FlowDirection="LeftToRight" />
         <TextBlock x:Name="FeatureText" TextWrapping="Wrap" Margin="2,8,2,0" Foreground="{DynamicResource Secondary}"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="OptionsPage" Visibility="Collapsed">
       <Border Style="{StaticResource PanelBorder}" Padding="14" Margin="0,0,0,11"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="DesktopLabel" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <CheckBox x:Name="Desktop" Grid.Column="1" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="{Binding Text, ElementName=DesktopLabel}"/>
       </Grid></Border>
       <Border Style="{StaticResource PanelBorder}" Padding="14"><Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
        <TextBlock x:Name="StartupLabel" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <CheckBox x:Name="Startup" Grid.Column="1" Style="{StaticResource SettingSwitch}" AutomationProperties.Name="{Binding Text, ElementName=StartupLabel}"/>
       </Grid></Border>
      </StackPanel>
      <StackPanel x:Name="ReviewPage" Visibility="Collapsed">
       <Border Style="{StaticResource PanelBorder}" Padding="14">
        <StackPanel><TextBlock x:Name="InstallPathLabel" Foreground="{DynamicResource Secondary}" Margin="0,0,0,6"/>
         <TextBlock x:Name="InstallPathValue" FlowDirection="LeftToRight" TextWrapping="Wrap"/>
         <TextBlock x:Name="ReviewTasks" TextWrapping="Wrap" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
       <TextBlock x:Name="ReviewStatus" TextWrapping="Wrap" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0"/>
      </StackPanel>
      <StackPanel x:Name="InstallPage" Visibility="Collapsed">
       <Border Style="{StaticResource PanelBorder}" Padding="16">
        <StackPanel>
         <ProgressBar x:Name="Progress" Height="9" Foreground="{DynamicResource Accent}" Maximum="100" IsIndeterminate="True"/>
         <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Secondary}" Margin="0,12,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
      <StackPanel x:Name="DonePage" Visibility="Collapsed">
       <Border Style="{StaticResource PanelBorder}" Padding="16"><StackPanel>
        <TextBlock Style="{StaticResource Glyph}" Text="&#xE73E;" Foreground="{DynamicResource Signal}" HorizontalAlignment="Left" FontSize="24" Margin="0,0,0,10"/>
        <TextBlock x:Name="DoneText" TextWrapping="Wrap"/>
       </StackPanel></Border>
      </StackPanel>
     </Grid>
    </Grid>
   </Grid>
   <Border Grid.Row="2" BorderBrush="{DynamicResource QuietLine}" BorderThickness="0,1,0,0">
    <DockPanel Margin="24,0">
     <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
      <Button x:Name="BackButton" Style="{StaticResource Quiet}" MinWidth="85" Margin="0,0,8,0" Click="BackClick"/>
      <Button x:Name="NextButton" Style="{StaticResource Primary}" MinWidth="114" Click="NextClick" IsDefault="True"/>
     </StackPanel>
     <TextBlock Text="{DynamicResource UiAllRightsReserved}" Foreground="{DynamicResource Muted}" VerticalAlignment="Center"/>
    </DockPanel>
   </Border>
  </Grid>
 </Border>
</Window>

